# WhatsApp Business API Configuration
# These are placeholder values. You must replace them with your actual Meta Developer credentials.

PORT=3000

# Your Meta App's WhatsApp Access Token
WHATSAPP_TOKEN="YOUR_WHATSAPP_ACCESS_TOKEN"

# The Phone Number ID assigned to you by Meta
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"

# The phone number where you want to receive the orders (e.g. your shop owner's number)
# Format: Country code followed by the number without '+' (e.g., "918122922900")
OWNER_PHONE_NUMBER="918122922900"
